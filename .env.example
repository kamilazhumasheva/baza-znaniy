# Postgres
DATABASE_URL="postgresql://kb_user:kb_password@localhost:5432/kb?schema=public"

# NextAuth (Auth.js v5)
AUTH_SECRET="change-me-to-a-random-32-byte-string"
AUTH_URL="http://localhost:3000"
# При деплое не на Vercel (Render, Railway, свой сервер) — обязательно true,
# иначе NextAuth отклоняет запросы с "чужого" на его взгляд домена.
AUTH_TRUST_HOST="true"

# Локальное файловое хранилище загруженных документов
STORAGE_DIR="./storage/uploads"

# Учётные данные для seed-администратора (создаётся при npm run db:seed)
SEED_ADMIN_EMAIL="admin@company.local"
SEED_ADMIN_PASSWORD="ChangeMe123!"

# Гостевой вход одной кнопкой (только для тестовых окружений!). По умолчанию
# выключен — не задавайте эту переменную на сервере компании.
# ENABLE_GUEST_LOGIN="true"

# Семантический поиск (опционально). Пока не задано — приложение работает
# на full-text + pg_trgm поиске без изменений, семантическая часть отключена.
# Как включить: см. раздел «Семантический поиск» в README.md.
# EMBEDDINGS_API_KEY="sk-..."
# EMBEDDINGS_MODEL="text-embedding-3-small"
